[Unit]
Description=Matter Primary Controller with BLE Commissioning
Documentation=https://github.com/project-chip/connectedhomeip
After=network-online.target avahi-daemon.service dbus.service ot-br-posix.service bluetooth.service
Wants=network-online.target
Requires=avahi-daemon.service bluetooth.service

# Wait for BlueZ to be fully ready (Pi 4 workaround)
ExecStartPre=/bin/bash -c 'while ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; do sleep 0.5; done'
ExecStartPre=/bin/sleep 2

# Wait for Thread interface
ExecStartPre=/bin/sh -c 'while ! ip link show wpan0 >/dev/null 2>&1; do sleep 1; done'

[Service]
Type=simple
User=root
Group=root

# Main executable - chip-all-clusters-app in controller mode
# ⚠️ CRITICAL: Verify these arguments work with your chip-all-clusters-app build!
# Check available options with: chip-all-clusters-app --help
# 
# Common arguments (adjust based on your build):
# --ble                                    Enable BLE
# --commissioning-window-timeout <sec>     Commissioning window timeout
# --commissioning-window-discriminator <n> Discriminator for BLE advertising
# --commissioning-window-pin <pin>         Setup PIN code
#
# If your build doesn't support these, you may need to:
# 1. Rebuild with controller features enabled
# 2. Use a different Matter Controller application
# 3. Implement custom commissioning window management
ExecStart=/usr/bin/chip-all-clusters-app \
    --ble \
    --commissioning-window-timeout 300 \
    --commissioning-window-discriminator 3840 \
    --commissioning-window-pin 12345678

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

# Environment variables
Environment="CHIP_DEVICE_CONFIG_WIFI_STATION_IF_NAME=wlan0"
Environment="CHIP_DEVICE_CONFIG_LINUX_DHCPC_CMD=udhcpc -b -i %s"
Environment="CHIP_DEVICE_CONFIG_THREAD_INTERFACE_NAME=wpan0"
Environment="CHIP_STORAGE_DIR=/var/lib/matter-controller"
Environment="CHIP_KVS_PATH=/var/lib/matter-controller/chip_kvs"
Environment="CHIP_FACTORY_CONFIG_PATH=/var/lib/matter-controller/chip_factory.ini"
Environment="CHIP_CONFIG_PATH=/var/lib/matter-controller/chip_config.ini"

# Security and resource limits
NoNewPrivileges=false
PrivateTmp=yes
ReadWritePaths=/var/lib/matter-controller
LimitNOFILE=65536

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=matter-controller

# PID file
PIDFile=/var/run/matter-controller.pid

[Install]
WantedBy=multi-user.target

